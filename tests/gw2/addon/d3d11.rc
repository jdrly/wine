/* gw2 (jdrly/gw2-on-mac#155): the version block of arcdps 1.2026.1023.2303's d3d11.dll, as its
 * strings read: a FileDescription and the versions, no CompanyName. Without one, Wine's
 * version_heuristics (dlls/ntdll/unix/loadorder.c) can't name a vendor, and a d3d11.dll at an
 * explicit path gets the default order, its built-in first. */
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,2026,1023,2303
PRODUCTVERSION 1,2026,1023,2303
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "100904b0"
        BEGIN
            VALUE "FileDescription", "gw2 test addon"
            VALUE "FileVersion", "1.2026.1023.2303"
            VALUE "ProductVersion", "1.2026.1023.2303"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x1009, 1200
    END
END
